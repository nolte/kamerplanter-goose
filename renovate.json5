{
  extends: [
    'github>nolte/gh-plumbing//renovate-configs/common#v2.0.0',
  ],
  mode: 'full',
  separateMajorMinor: true,
  separateMinorPatch: false,
  packageRules: [
    {
      groupName: 'github-actions',
      matchManagers: [
        'github-actions',
      ],
      matchUpdateTypes: [
        'minor',
        'patch',
        'digest',
      ],
      automerge: true,
    },
    {
      groupName: 'github-actions major',
      matchManagers: [
        'github-actions',
      ],
      matchUpdateTypes: [
        'major',
      ],
    },
    {
      groupName: 'pre-commit hooks',
      matchManagers: [
        'pre-commit',
      ],
      automerge: true,
    },
    {
      // The docs toolchain is pinned in docs/requirements.txt. Group the
      // bumps so a MkDocs/Material pair lands in one PR rather than two that
      // each break `mkdocs build --strict` on their own.
      groupName: 'mkdocs toolchain',
      matchFileNames: [
        'docs/requirements.txt',
      ],
      automerge: false,
    },
  ],
}
