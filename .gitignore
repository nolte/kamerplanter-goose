__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/

# Task runner cache
.task/

# Editor / IDE
.vscode/
.idea/
*.swp
*~

# OS
.DS_Store
Thumbs.db

# Logs
*.log
