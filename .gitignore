# Claude Code — local / user-specific
.claude/settings.local.json
.claude/*.local.json
.claude/.credentials.json

# MkDocs build output
/site/

# Resume scratch — in-flight skill/agent state per spec/claude/resumable-work/
/.resume/

# Audit artifacts — findings convert to issues/PRs, the reports stay local
/.audits/

# Goose — session state and local recipe overrides
.goose/

# Environment — .envrc is tracked, the credentials it resolves are not
.env
.env.*
!.env.example

