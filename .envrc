# No trailing slash, for the same reason as KAMERPLANTER_URL below:
# extensions.yaml builds "${HA_URL}/api/mcp".
export HA_URL="https://home-assistant.just-a-lab.duckdns.org"
export HA_MCP_TOKEN=$(pass network/homeassistant/api/token-mcp )

# export KAMERPLANTER_URL="http://localhost:3000"
# export KAMERPLANTER_API_KEY=$(pass network/kamerplanter.local/api/token-mcp )


# No trailing slash: extensions.yaml builds "${KAMERPLANTER_URL}/api/v1/mcp" and
# scripts/analyse-queue.sh the same, so a slash here yields host//api/v1/mcp. It
# answers today, but a proxy that does not collapse the double slash would make
# connectivity-check report a server fault for what is a config error.
export KAMERPLANTER_URL="https://kamerplanter.just-a-lab.duckdns.org"
export KAMERPLANTER_API_KEY=$(pass network/kamerplanter/api/token-mcp )

export GITHUB_MCP_PAT=$(gh auth token)


# Taskfile.yml pulls the worktree module from nolte/taskfiles. Remote includes
# are still a Task experiment, and Task parses every include at startup — so
# without these two no target runs at all, not just the remote ones. Task 3.52
# additionally refuses an untrusted host, and answers "not trusted by user"
# whether the flag above is set or not, which reads like the experiment is off.
export TASK_X_REMOTE_TASKFILES=1
export TASK_TRUSTED_HOSTS=raw.githubusercontent.com

export GOOSE_RECIPE_PATH="$PWD/recipes"
# Shared MCP extensions — only applies to recipes with no `extensions:` block
export GOOSE_ADDITIONAL_CONFIG_FILES="$PWD/extensions.yaml"
